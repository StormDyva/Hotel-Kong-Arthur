# Local development only; .env must never be committed.
POSTGRES_DB=hotel_kong_arthur
POSTGRES_USER=hotel_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_ADMIN_USER=hotel_admin
POSTGRES_ADMIN_PASSWORD=change_me_locally
# Host port; containers connect to db:5432.
POSTGRES_PORT=5433
API_PORT=8000
FRONTEND_PORT=5500
# Optional for Python commands outside Compose (overrides POSTGRES_*):
# DATABASE_URL=postgresql+psycopg://hotel_app:change_me_locally@127.0.0.1:5433/hotel_kong_arthur
# PostgreSQL uses a NEW postgres_data volume. Existing mysql_data is preserved.
