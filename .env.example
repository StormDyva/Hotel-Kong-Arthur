# Local development values only. Copy to .env and replace passwords locally.
MYSQL_DATABASE=hotel_kong_arthur
MYSQL_USER=hotel_app
MYSQL_PASSWORD=change_me_locally
MYSQL_ROOT_PASSWORD=change_me_locally
# Host port only; API uses db:3306 inside Compose.
MYSQL_PORT=3307
API_PORT=8000
FRONTEND_PORT=5500
# CORS follows FRONTEND_PORT; .env is read by Compose, not exported to your shell.
# Existing MySQL volume credentials are not changed by editing these values.
